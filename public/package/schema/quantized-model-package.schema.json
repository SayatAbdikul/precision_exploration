{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:precision-exploration:quantized-model-package:1.0.0",
  "title": "Public Quantized Model Candidate Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_name",
    "selection_categories",
    "experiment_sha256",
    "model_graph",
    "encoded_weights",
    "tensor_scales",
    "datatype_manifests",
    "operator_metadata",
    "arithmetic",
    "public_quality",
    "generic_hardware",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "package_id": {
      "$ref": "#/$defs/sha256",
      "readOnly": true,
      "description": "Derived from canonical package metadata after this field is removed."
    },
    "candidate_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "selection_categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "highest_quality",
          "lowest_energy",
          "lowest_area",
          "highest_images_per_joule",
          "highest_images_per_second_per_mm2",
          "knee_point",
          "family_alternative",
          "guard"
        ]
      }
    },
    "selection_reason": {
      "type": "string",
      "minLength": 1
    },
    "experiment_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "model_graph": {
      "$ref": "#/$defs/artifactRef"
    },
    "encoded_weights": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifactRef"
      }
    },
    "tensor_scales": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifactRef"
      }
    },
    "datatype_manifests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weight", "activation", "accumulator", "output"],
      "properties": {
        "weight": {
          "$ref": "#/$defs/manifestRef"
        },
        "activation": {
          "$ref": "#/$defs/manifestRef"
        },
        "accumulator": {
          "$ref": "#/$defs/manifestRef"
        },
        "output": {
          "$ref": "#/$defs/manifestRef"
        }
      }
    },
    "operator_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantics_version", "policy", "batchnorm_folded", "bias_domain"],
      "properties": {
        "semantics_version": {
          "type": "string",
          "minLength": 1
        },
        "policy": {
          "enum": ["strict", "practical"]
        },
        "batchnorm_folded": {
          "const": true
        },
        "bias_domain": {
          "const": "accumulator"
        }
      }
    },
    "arithmetic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mac_model",
        "product_precision",
        "reduction_order",
        "requantization_point"
      ],
      "properties": {
        "mac_model": {
          "enum": ["native", "rounded_product_wide_accumulator", "full_product"]
        },
        "product_precision": {
          "enum": ["rounded_to_operand", "exact_to_accumulator"]
        },
        "reduction_order": {
          "enum": ["sequential", "tree"]
        },
        "requantization_point": {
          "const": "operator_output_store"
        }
      }
    },
    "public_quality": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/qualityEvidence"
      }
    },
    "generic_hardware": {
      "$ref": "#/$defs/hardwareEvidence"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint_sha256",
        "graph_sha256",
        "calibration_manifest_sha256",
        "evaluation_manifest_sha256",
        "software_commit",
        "repository_state"
      ],
      "properties": {
        "checkpoint_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "graph_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "calibration_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "evaluation_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "software_commit": {
          "type": "string",
          "minLength": 1
        },
        "repository_state": {
          "enum": ["clean", "dirty"]
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "type": "string"
        }
      }
    },
    "manifestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "sha256"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "metricSet": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "number"
      }
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "lower", "upper", "method"],
      "properties": {
        "level": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "lower": {
          "type": "number"
        },
        "upper": {
          "type": "number"
        },
        "method": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "qualityEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workload",
        "evaluation_manifest_sha256",
        "fp32_metrics",
        "quantized_metrics",
        "delta_metrics",
        "confidence_intervals"
      ],
      "properties": {
        "workload": {
          "type": "string",
          "minLength": 1
        },
        "evaluation_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "fp32_metrics": {
          "$ref": "#/$defs/metricSet"
        },
        "quantized_metrics": {
          "$ref": "#/$defs/metricSet"
        },
        "delta_metrics": {
          "$ref": "#/$defs/metricSet"
        },
        "confidence_intervals": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/interval"
          }
        }
      }
    },
    "hardwareEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configuration_sha256",
        "pdk",
        "library",
        "corner",
        "vt",
        "metrics",
        "quality_attached",
        "evidence_level"
      ],
      "properties": {
        "configuration_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "pdk": {
          "type": "string",
          "minLength": 1
        },
        "library": {
          "type": "string",
          "minLength": 1
        },
        "corner": {
          "type": "string",
          "minLength": 1
        },
        "vt": {
          "type": "string",
          "minLength": 1
        },
        "metrics": {
          "$ref": "#/$defs/metricSet"
        },
        "quality_attached": {
          "const": true
        },
        "evidence_level": {
          "enum": ["primitive", "mac_fpu", "all_in_datapath", "generic_system"]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
